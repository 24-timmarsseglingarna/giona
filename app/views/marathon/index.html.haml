:css
  .dist-narrow { display: none; }
  @media (max-width: 1400px) {
    .dist-wide { display: none; }
    .dist-narrow { display: inline; }
  }

  .print-heading { display: none; }

.panel.panel-default
  .panel-heading
    %i.fa.fa-trophy(aria-hidden='true')
    Maratonlistan

  .panel-body
    = form_tag marathon_path, method: :get, class: 'form-inline' do
      .form-group
        = label_tag :year, 'Från år:'
        = select_tag :year,
            options_for_select([['-', '']] + (2000..Date.today.year).to_a.reverse.map { |y| [y, y] }, @year),
            class: 'form-control', onchange: 'this.form.submit()'
      &nbsp;
      .form-group
        = label_tag :organizer_id, 'Krets:'
        = select_tag :organizer_id,
            options_for_select([['-', '']] + @organizers.map { |o| [o.name, o.id] }, @organizer_id),
            class: 'form-control', onchange: 'this.form.submit()'
      &nbsp;
      %i.fas.fa-file-excel(aria-hidden='true')
      = link_to 'Exportera xlsx', marathon_path(year: @year, organizer_id: @organizer_id, format: :xlsx), class: 'btn btn-default btn-sm'

    %h3.print-heading
      Maratonlistan
      - if @year
        = " från #{@year}"
      - if @organizer_id
        - org = @organizers.find { |o| o.id.to_s == @organizer_id.to_s }
        = " – #{org.name}" if org

    %br

    %table#giona-marathon.table.table-striped.table-bordered.table-hover{width: '100%'}
      %thead
        %tr
          %th Plats
          %th Förnamn
          %th Efternamn
          %th Senaste båt
          %th Senaste båttyp
          %th
            %span.dist-wide Seglad distans
            %span.dist-narrow
              Seglad
              %br
              distans
          %th
            %span.dist-wide Plakettdistans
            %span.dist-narrow
              Plakett-
              %br
              distans
          %th Senaste år
          - unless @organizer_id
            %th Krets
          - if has_officer_rights? && @year
            %th Ny plakett i år
      %tbody
        - @rows.each_with_index do |row, idx|
          - mp = row[:marathon_person]
          %tr{class: (has_officer_rights? && row[:new_plaques].any?) ? 'success' : ''}
            %td{style: 'white-space: nowrap'}
              = idx + 1
              - if mp.hourglass
                %i.fa.fa-hourglass.pull-right{'aria-hidden' => 'true', title: "Timglas #{mp.hourglass}"}
            %td= mp.first_name
            %td= mp.last_name
            %td= row[:latest_boat_name]
            %td= row[:latest_boat_type]
            %td= row[:total_sailed_dist].round()
            %td= row[:total_plaque_dist].round()
            %td= row[:latest_year]
            - unless @organizer_id
              %td= row[:latest_organizer]&.external_id
            - if has_officer_rights? && @year
              %td
                - row[:new_plaques].each do |p|
                  %span.label.label-success= "#{p[:plaque]} #{p[:series]}"

:javascript
  $(document).ready(function() {
    $('#giona-marathon').DataTable({
      paging: false,
      ordering: false,
      language: {
        search: "Sök:",
        info: "Visar rad _START_ till _END_ av _TOTAL_",
        zeroRecords: "Det finns inget som passar urvalet.",
        emptyTable: "Tabellen är tom."
      }
    });
  });
