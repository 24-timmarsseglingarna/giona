:css
  .dist-narrow { display: none; }
  @media (max-width: 1400px) {
    .dist-wide { display: none; }
    .dist-narrow { display: inline; }
  }

  .print-header, .print-subheading { display: none; }

  .marathon-hourglass { height: 1.1em; width: auto; vertical-align: -0.2em; }

  @media print {
    @page {
      size: A4 portrait;
      margin: 10mm;
    }

    /* Print the table only - no filters, no search box, no buttons. */
    .marathon-noprint,
    .dataTables_filter,
    .dataTables_info,
    .dataTables_length,
    .dataTables_paginate { display: none !important; }

    /* Logo + heading text, as on the paper lists. */
    .print-header {
      display: flex !important;
      align-items: flex-start;
      font-family: Helvetica, Arial, sans-serif;
      margin-bottom: 6mm;
    }
    .print-header-logo { width: 20mm; height: auto; margin-right: 5mm; }
    .print-header-text { flex: 1 1 auto; }
    .print-header-club { font-size: 17pt; font-weight: bold; line-height: 1.2; }
    .print-header-org { font-size: 14pt; line-height: 1.3; }
    .print-header-line { font-size: 11pt; line-height: 1.3; }
    .print-header-result { font-size: 9pt; line-height: 1.3; }
    .print-header-date {
      flex: 0 0 auto;
      font-size: 11pt;
      padding-top: 7mm;
      white-space: nowrap;
    }
    .print-subheading { display: block !important; }

    .panel { border: none; margin-top: 0; box-shadow: none; }
    .panel-heading { display: none !important; }
    .panel-body { padding: 0; }

    #giona-marathon { font-size: 9px; width: 100% !important; }
    #giona-marathon th,
    #giona-marathon td { padding: 2px 3px !important; width: auto !important; }
    /* Repeat the header on every page, and keep rows whole. */
    #giona-marathon thead { display: table-header-group; }
    #giona-marathon tr { page-break-inside: avoid; }
  }

.panel.panel-default
  .panel-heading
    %i.fa.fa-trophy(aria-hidden='true')
    Maratonlistan

  .panel-body
    = form_tag marathon_path, method: :get, class: 'form-inline marathon-noprint' do
      .form-group
        = label_tag :year, 'Från år:'
        = select_tag :year,
            options_for_select([['-', '']] + (2000..Date.today.year).to_a.reverse.map { |y| [y, y] }, @year),
            class: 'form-control', onchange: 'this.form.submit()'
      &nbsp;
      .form-group
        = label_tag :organizer_id, 'Krets:'
        = select_tag :organizer_id,
            options_for_select([['-', '']] + @organizers.map { |o| [o.name, o.id] }, @organizer_id),
            class: 'form-control', onchange: 'this.form.submit()'
      - if has_officer_rights?
        &nbsp;
        %div{style: 'display: inline-block; vertical-align: middle; text-align: left'}
          .radio{style: 'display: block; margin: 0'}
            %label
              = radio_button_tag :highlight, '', @highlight.nil?, onchange: 'this.form.submit()'
              Ingen markering
          .radio{style: 'display: block; margin: 0'}
            %label
              = radio_button_tag :highlight, 'new_plaques', @highlight == 'new_plaques', onchange: 'this.form.submit()'
              Plaketter från valt år
          .radio{style: 'display: block; margin: 0'}
            %label
              = radio_button_tag :highlight, 'near_plaque', @highlight == 'near_plaque', onchange: 'this.form.submit()'
              Nära till plakett
        &nbsp;
        %div{style: 'display: inline-block; vertical-align: middle; text-align: left'}
          .radio{style: 'display: block; margin: 0'}
            %label
              = radio_button_tag :show, 'all', !@show_selected, onchange: 'this.form.submit()'
              Visa alla
          .radio{style: 'display: block; margin: 0'}
            %label
              = radio_button_tag :show, 'selected', @show_selected, onchange: 'this.form.submit()'
              Visa valda
      %span.pull-right
        %i.fas.fa-file-excel(aria-hidden='true')
        = link_to 'Exportera xlsx', marathon_path(year: @year, organizer_id: @organizer_id, highlight: @highlight, show: (@show_selected ? 'selected' : nil), format: :xlsx), class: 'btn btn-default btn-sm'
        &nbsp;
        %i.fas.fa-print(aria-hidden='true')
        %button.btn.btn-default.btn-sm{type: 'button', onclick: 'window.print(); return false;'} Skriv ut / pdf

    - if @highlight_emails.present?
      %p.marathon-noprint
        %button.btn.btn-default.btn-sm{type: 'button', onclick: "var e = document.getElementById('highlight-emails'); e.style.display = (e.style.display === 'none' ? 'block' : 'none');"}
          = "Visa e-postadresser (#{@highlight_emails.size})"
      %textarea#highlight-emails.form-control.marathon-noprint{readonly: true, rows: 3, style: 'display: none'}= @highlight_emails.join(', ')

    -# Only shown when printing; the logo and heading text describe the
    -# filters the table was generated from.
    .print-header
      = image_tag 'sxk_symbol_gul.jpg', class: 'print-header-logo', alt: ''
      .print-header-text
        .print-header-club Svenska Kryssarklubben
        .print-header-org= @organizer ? @organizer.short_name : '24-timmarsnämnden'
        .print-header-line= "Maratonlista #{@latest_log_date&.year}"
        - if @year
          .print-header-result= "Resultat #{@year} - #{@latest_log_date&.year}"
      - if @latest_log_date
        .print-header-date= I18n.l @latest_log_date, format: :day
    - if @highlight == 'new_plaques'
      %p.print-subheading= @show_selected ? 'Endast plaketter från valt år' : 'Plaketter från valt år markerade'
    - elsif @highlight == 'near_plaque'
      %p.print-subheading= @show_selected ? 'Endast nära till plakett' : 'Nära till plakett markerade'

    %br

    %table#giona-marathon.table.table-striped.table-bordered.table-hover{width: '100%'}
      %thead
        %tr
          %th Plats
          %th Förnamn
          %th Efternamn
          %th Senaste båt
          %th Senaste båttyp
          %th
            %span.dist-wide Seglad distans
            %span.dist-narrow
              Seglad
              %br
              distans
          %th
            %span.dist-wide Plakettdistans
            %span.dist-narrow
              Plakett-
              %br
              distans
          %th Senaste år
          - unless @organizer_id
            %th Krets
          - if has_officer_rights? && @year && @highlight == 'new_plaques'
            %th Ny plakett i år
          - if has_officer_rights? && @highlight == 'near_plaque'
            %th Nästa plakett
      %tbody
        - @rows.each do |row|
          - mp = row[:marathon_person]
          - row_class = '' unless has_officer_rights?
          - row_class ||= 'success' if row[:new_plaques].any?
          - row_class ||= 'warning' if row[:near_plaque]
          %tr{class: row_class}
            %td{style: 'white-space: nowrap'}
              = row[:place]
              - if mp.hourglass
                = image_tag 'hourglass.png', class: 'marathon-hourglass pull-right', title: "Timglas #{mp.hourglass}", alt: 'Timglas'
            %td= mp.first_name
            %td= mp.last_name
            %td= row[:latest_boat_name]
            %td= row[:latest_boat_type]
            %td= row[:total_sailed_dist].round()
            %td= row[:total_plaque_dist].round()
            %td= row[:latest_year]
            - unless @organizer_id
              %td= row[:latest_organizer]&.external_id
            - if has_officer_rights? && @year && @highlight == 'new_plaques'
              %td
                - row[:new_plaques].each do |p|
                  %span.label.label-success= "#{p[:plaque]} #{p[:series]}"
            - if has_officer_rights? && @highlight == 'near_plaque'
              %td
                - if (p = row[:next_plaque])
                  %span.label.label-warning= "#{p[:plaque]} #{p[:series]}"

:javascript
  $(document).ready(function() {
    $('#giona-marathon').DataTable({
      paging: false,
      ordering: false,
      language: {
        search: "Sök:",
        info: "Visar rad _START_ till _END_ av _TOTAL_",
        zeroRecords: "Det finns inget som passar urvalet.",
        emptyTable: "Tabellen är tom."
      }
    });
  });
